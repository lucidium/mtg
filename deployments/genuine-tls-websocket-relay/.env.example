# Public DNS name covered by the mounted certificate.
DOMAIN=relay.example.com

# Must exactly match [websocket-relay].path in state/mtg.toml.
# This is defense in depth, not the relay credential.
RELAY_PATH=/relay/v1/replace-with-a-random-path

# Host-network ports bound directly by Nginx. Change these when the defaults are
# already occupied. Clients must connect to HTTPS_PORT; HTTP_PORT only redirects
# ordinary plaintext requests to HTTPS_PORT.
HTTP_PORT=80
HTTPS_PORT=443

# Loopback-only Nginx health endpoint used by the Compose health check.
NGINX_HEALTH_PORT=8080

# Existing absolute host paths on the Ubuntu VPS. The certificate file must
# contain the server certificate followed by its intermediate chain.
TLS_CERTIFICATE_PATH=/etc/ssl/relay.example.com/fullchain.pem
TLS_CERTIFICATE_KEY_PATH=/etc/ssl/relay.example.com/privkey.pem

# Linux UID/GID allowed to read state/mtg.toml. The deployment guide creates a
# dedicated account and records its values here.
MTG_UID=1000
MTG_GID=1000

# Optional local image label; no registry image is required.
MTG_IMAGE_TAG=local